# Public app URL used for OAuth redirects and absolute links.
APP_BASE_URL=
# Replay, sandbox, or live execution boundary.
APP_ENV=replay
VOICE_TRANSPORT=sip_trunk
# Supabase project URL required for authentication and data access.
SUPABASE_URL=
# Supabase publishable key used by browser-session server clients.
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key for privileged server-side operations only.
SUPABASE_SECRET_KEY=
# Versioned key for encrypting OAuth credentials at rest.
CREDENTIAL_ENCRYPTION_KEY=
# Inngest event publishing key.
INNGEST_EVENT_KEY=
# Inngest request-signature verification key.
INNGEST_SIGNING_KEY=
# DeepSeek API key for planner inference.
DEEPSEEK_API_KEY=
# OpenAI-compatible DeepSeek API endpoint.
DEEPSEEK_BASE_URL=
# Exact DeepSeek model identifier.
DEEPSEEK_MODEL=
# Optional. Set to "true" to enable DeepSeek thinking mode for the planner and
# extraction. Blank or "false" keeps thinking off (the B0 default); any other
# value is rejected at startup.
# Hidden reasoning stays server-private; see docs/prd/05-agent-and-integrations.md.
DEEPSEEK_THINKING_ENABLED=
# Google OAuth client ID for Gmail access.
GOOGLE_CLIENT_ID=
# Google OAuth client secret for Gmail access.
GOOGLE_CLIENT_SECRET=
# Registered Gmail OAuth callback URL.
GOOGLE_REDIRECT_URI=
# Gmail provider: google (default) or composio.
GMAIL_PROVIDER=google
# Optional Gmail push via Cloud Pub/Sub (additive; the 10-minute poll stays on). See docs/gmail-push-setup.md.
# Full topic name Gmail publishes to: projects/<gcp-project>/topics/<topic>.
GMAIL_PUBSUB_TOPIC=
# Audience on the push subscription's OIDC token. Defaults to ${APP_BASE_URL}/api/webhooks/gmail.
GMAIL_PUBSUB_AUDIENCE=
# Service account email the push subscription signs its OIDC token as.
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Microsoft Outlook (Graph) mailbox support. See docs/outlook-setup.md. All three are needed to connect Outlook.
# Application (client) ID of the Microsoft Entra app registration.
MICROSOFT_CLIENT_ID=
# Client secret value (not the secret ID) of that registration.
MICROSOFT_CLIENT_SECRET=
# Registered redirect URI: https://<app host>/api/auth/outlook/callback
MICROSOFT_REDIRECT_URI=
# Optional. common (default: work, school and personal accounts), organizations, consumers, a tenant ID or a domain.
MICROSOFT_TENANT_ID=
# Composio API key for Gmail connections and tool execution.
COMPOSIO_API_KEY=
# Composio Gmail auth config ID.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
# ElevenLabs API key for supplier voice calls.
ELEVENLABS_API_KEY=
# ElevenLabs conversational agent identifier.
ELEVENLABS_AGENT_ID=
# ElevenLabs phone-number identifier for outbound calls.
ELEVENLABS_PHONE_NUMBER_ID=
# ElevenLabs callback signature verification secret.
ELEVENLABS_WEBHOOK_SECRET=
VOICE_BRIDGE_URL=
VOICE_BRIDGE_SECRET=
# Exa API key for public supplier discovery.
EXA_API_KEY=
# SignalWire space URL for optional carrier management.
SIGNALWIRE_SPACE_URL=
# SignalWire project ID for optional carrier management.
SIGNALWIRE_PROJECT_ID=
# SignalWire API token for optional carrier management.
SIGNALWIRE_API_TOKEN=
# Setup script only: caller ID owned by your SignalWire account, in E.164 format.
SIGNALWIRE_PHONE_NUMBER=
# PSTN termination Domain Application hostname, e.g. conduit.dapp.signalwire.com.
# A *.sip.signalwire.com SIP Credential domain is for registered devices.
SIGNALWIRE_SIP_ADDRESS=
# Digest credentials for the Domain Application; obtain them from SignalWire Support.
# These are separate from a SIP device password or SignalWire API token.
SIGNALWIRE_SIP_USERNAME=
SIGNALWIRE_SIP_PASSWORD=
# Shopify OAuth app credentials; also used to refresh expiring offline tokens.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Live connector tests (tests/domain/shopify-live.test.ts). Leave unset to skip them.
# SHOPIFY_LIVE_TEST=preflight reads only; SHOPIFY_LIVE_TEST=1 creates tagged transfers and shipments.
# These only ever write to the one development store named below.
SHOPIFY_LIVE_TEST=
# Development store domain, e.g. conduit-dev.myshopify.com.
SHOPIFY_LIVE_SHOP=
# Must repeat SHOPIFY_LIVE_SHOP exactly before any write is allowed.
SHOPIFY_LIVE_CONFIRM_DEV_STORE=
# Location gid the seeded transfers deliver to, e.g. gid://shopify/Location/123.
SHOPIFY_LIVE_LOCATION_ID=
# Tracked inventory item gid used on the seeded transfers, e.g. gid://shopify/InventoryItem/456.
SHOPIFY_LIVE_INVENTORY_ITEM_ID=
# Credentials: either a token that stays valid for the run...
SHOPIFY_LIVE_ACCESS_TOKEN=
# ...or an expiring offline refresh token (uses SHOPIFY_CLIENT_ID/SECRET; rotated pairs are written to the token file).
SHOPIFY_LIVE_REFRESH_TOKEN=
# Defaults to ~/.conduit-shopify-live.json.
SHOPIFY_LIVE_TOKEN_FILE=
# Set to 1 only to allow a non-development plan (not recommended).
SHOPIFY_LIVE_ALLOW_NON_DEV_PLAN=
