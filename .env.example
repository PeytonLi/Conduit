# Public app URL used for OAuth redirects and absolute links.
APP_BASE_URL=
# Replay, sandbox, or live execution boundary.
APP_ENV=replay
# Supabase project URL required for authentication and data access.
SUPABASE_URL=
# Supabase publishable key used by browser-session server clients.
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key for privileged server-side operations only.
SUPABASE_SECRET_KEY=
# Versioned key for encrypting OAuth credentials at rest.
CREDENTIAL_ENCRYPTION_KEY=
# Inngest event publishing key.
INNGEST_EVENT_KEY=
# Inngest request-signature verification key.
INNGEST_SIGNING_KEY=
# DeepSeek API key for planner inference.
DEEPSEEK_API_KEY=
# OpenAI-compatible DeepSeek API endpoint.
DEEPSEEK_BASE_URL=
# Exact DeepSeek model identifier.
DEEPSEEK_MODEL=
# Google OAuth client ID for Gmail access.
GOOGLE_CLIENT_ID=
# Google OAuth client secret for Gmail access.
GOOGLE_CLIENT_SECRET=
# Registered Gmail OAuth callback URL.
GOOGLE_REDIRECT_URI=
# ElevenLabs API key for supplier voice calls.
ELEVENLABS_API_KEY=
# ElevenLabs conversational agent identifier.
ELEVENLABS_AGENT_ID=
# ElevenLabs phone-number identifier for outbound calls.
ELEVENLABS_PHONE_NUMBER_ID=
# ElevenLabs callback signature verification secret.
ELEVENLABS_WEBHOOK_SECRET=
# Exa API key for public supplier discovery.
EXA_API_KEY=
# Neatlogs project key for runtime traces.
NEATLOGS_API_KEY=
# Neatlogs ingestion endpoint for runtime traces.
NEATLOGS_ENDPOINT=
# SignalWire space URL for optional carrier management.
SIGNALWIRE_SPACE_URL=
# SignalWire project ID for optional carrier management.
SIGNALWIRE_PROJECT_ID=
# SignalWire API token for optional carrier management.
SIGNALWIRE_API_TOKEN=
